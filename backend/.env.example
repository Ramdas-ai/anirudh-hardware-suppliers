# Server
PORT=5000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Database — REQUIRED from Phase 4 onward. Use a local MongoDB
# (mongodb://localhost:27017/anirudh-hardware) or a MongoDB Atlas
# connection string. Never commit the real value.
MONGO_URI=

# Auth — REQUIRED from Phase 4 onward. JWT_SECRET should be a long random
# string (e.g. `openssl rand -hex 32`) — never commit the real value.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary (image storage — added when products are built, Phase 2)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# eSewa (added in Phase 9 — use test/UAT values until you have real merchant credentials)
ESEWA_MERCHANT_ID=
ESEWA_SECRET_KEY=
ESEWA_ENVIRONMENT=test

# Email / SMTP (added in Phase 10)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ADMIN_NOTIFICATION_EMAIL=
